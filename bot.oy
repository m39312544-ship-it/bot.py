import os, time, threading, runpy
import requests


def ping():
    url = os.environ.get("RENDER_EXTERNAL_URL")
    while url:
        time.sleep(600)
        try:
            requests.get(url, timeout=20)
        except Exception:
            pass


threading.Thread(target=ping, daemon=True).start()
runpy.run_path("bot.py", run_name="__main__")
